{
    "name": "ozhantr/ebnf",
    "description": "Production-grade, framework-agnostic PHP library for parsing EBNF grammars.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "autoload": {
        "psr-4": {
            "Ozhantr\\Ebnf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ozhantr\\Ebnf\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse -c phpstan.neon.dist --debug",
        "lint": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
